{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "general": {},
  "logo": {
    "source": "$HOME/.config/fastfetch/maid.png",
    "type": "kitty-direct",
    "height": 14,
    "width": 32,
    "padding": {
      "top": 1,
      "left": 2,
      "right": 2,
      "bottom": 0
    }
  },
  "modules": [
    "break",
    {
      "type": "host",
      "key": "   ",
      "format": "{version}",
      "keyColor": "white"
    },
    {
      "type": "display",
      "key": "  󰍹 ",
      "format": "{width}x{height} [{refresh-rate}hz]",
      "keyColor": "white"
    },
    {
      "type": "cpu",
      "key": "   ",
      "format": "{name}",
      "keyColor": "white"
    },
    {
      "type": "gpu",
      "key": "   ",
      "format": "{vendor} {name}",
      "keyColor": "white"
    },
    {
      "type": "memory",
      "key": "   ",
      "format": "{used} / {total} [{percentage}]",
      "keyColor": "white"
    },
    {
      "type": "disk",
      "key": "   ",
      "format": "{size-used} / {size-total} [{filesystem} on {mountpoint}]",
      "keyColor": "white"
    },
    {
      "type": "os",
      "key": "   ",
      "format": "{name} [{arch}]",
      "keyColor": "white"
    },
    {
      "type": "battery",
      "key": "   ",
      "format": "{status} [{cycle-count} cycle]",
      "keyColor": "white"
    },
    {
      "type": "wm",
      "key": "   ",
      "format": "{pretty-name} {version} [{protocol-name}]",
      "keyColor": "white"
    },
    {
      "type": "terminal",
      "key": "   ",
      "format": "{pretty-name} {version}",
      "keyColor": "white"
    },
    "break"
  ]
}
